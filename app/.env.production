# Chỉ nạp khi `vite build` (mode "production" mặc định) — GHI ĐÈ giá trị dev
# trong app/.env. Domain THẬT của site tĩnh (index.html, dang-nhap.html...)
# sau khi chốt kiến trúc subdomain — xem app/CLAUDE.md mục "Giả định host".
VITE_MAIN_SITE_URL=https://agrichain.org.vn

# Domain THẬT của backend (api.agrichain.org.vn, VPS + Nginx) — thiếu biến
# này thì src/api/config.ts THROW LỖI NGAY lúc khởi động (2026-09-30, không
# còn fallback ngầm về domain Render cũ như trước nữa).
VITE_API_BASE_URL=https://api.agrichain.org.vn
